[user]
	email = ethanez713@gmail.com
	name = Ethan Zhou
[alias]
	co = checkout
	br = branch
	ci = commit
	st = status
	pr = pull --rebase
	rc = rebase --continue
	rs = rebase --skip
	undo-commit = reset --soft HEAD^
[core]
	editor = emacs -nw
	excludesfile = ~/.gitignore

[url "ssh://git@github.com/"]
	insteadOf = https://github.com/
[color]
	status = auto
[credential "https://github.com"]
	helper = 
	helper = !/home/ezhou/.local/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/home/ezhou/.local/bin/gh auth git-credential
